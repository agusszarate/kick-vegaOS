{
  "name": "kicktv-vega",
  "version": "0.2.0",
  "description": "Unofficial, lightweight Kick.com player for Fire TV devices running Vega OS",
  "license": "MIT",
  "private": true,
  "keywords": [
    "kick",
    "fire-tv",
    "vega-os",
    "react-native",
    "hls",
    "tv"
  ],
  "scripts": {
    "clean": "rm -rf node_modules buildinfo.json dist build assets/app.js",
    "start": "react-native start",
    "build:web": "node web/build.mjs",
    "watch:web": "node web/build.mjs --watch",
    "typecheck": "tsc -p . --noEmit && tsc -p web --noEmit",
    "test": "jest --colors && jest --colors -c web/jest.config.js",
    "lint": "eslint src test shared web/src web/test --ext .ts,.tsx",
    "lint:fix": "eslint src test shared web/src web/test --ext .ts,.tsx --fix",
    "build:release": "npm run build:web && react-native build-vega --build-type Release",
    "build:debug": "npm run build:web && react-native build-vega --build-type Debug",
    "build": "npm run build:release",
    "check": "npm run typecheck && npm run lint && npm test"
  },
  "dependencies": {
    "@amazon-devices/react-native-kepler": "^4.0.0",
    "@amazon-devices/webview": "^4.0.0",
    "react": "19.2.0",
    "react-native": "0.83.0"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@amazon-devices/eslint-plugin-kepler": "^0.1.4",
    "@amazon-devices/kepler-cli-platform": "^0",
    "@react-native-community/cli": "20.0.0",
    "@react-native/babel-preset": "0.83.0",
    "@react-native/eslint-config": "0.83.0",
    "@react-native/metro-config": "0.83.0",
    "@testing-library/react-native": "^13.0.0",
    "@types/jest": "^29.5.14",
    "@types/react": "^19.2.0",
    "@types/react-test-renderer": "^19.1.0",
    "@typescript-eslint/eslint-plugin": "^6.5.0",
    "babel-jest": "^29.7.0",
    "esbuild": "0.24.0",
    "eslint": "^8.57.1",
    "eslint-plugin-jest": "^27.6.0",
    "hls.js": "1.5.17",
    "jest": "^29.7.0",
    "jsonc-eslint-parser": "^2.4.0",
    "npm-run-all": "^4.1.5",
    "prettier": "^2.8.8",
    "qrcode-generator": "1.4.4",
    "react-test-renderer": "19.2.0",
    "ts-jest": "^29.2.5",
    "typescript": "5.8.3"
  },
  "kepler": {
    "projectType": "application",
    "appName": "KickTV",
    "targets": [
      "tv"
    ]
  },
  "overrides": {
    "react": "19.2.0",
    "react-native": "0.83.0"
  }
}
