{
  "name": "kick-vegaos",
  "version": "0.4.0",
  "description": "Unofficial, lightweight Kick.com player for Fire TV devices running Vega OS",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/agusszarate/kick-vegaOS.git"
  },
  "homepage": "https://github.com/agusszarate/kick-vegaOS#readme",
  "bugs": {
    "url": "https://github.com/agusszarate/kick-vegaOS/issues"
  },
  "private": true,
  "keywords": [
    "kick",
    "fire-tv",
    "vega-os",
    "react-native",
    "hls",
    "tv"
  ],
  "scripts": {
    "postinstall": "bash scripts/setup-shaka.sh",
    "clean": "rm -rf node_modules buildinfo.json dist build src/vendor .shaka-build",
    "start": "react-native start",
    "typecheck": "tsc -p . --noEmit",
    "test": "jest --colors",
    "lint": "eslint src test --ext .ts,.tsx",
    "lint:fix": "eslint src test --ext .ts,.tsx --fix",
    "build:release": "react-native build-vega --build-type Release",
    "build:debug": "react-native build-vega --build-type Debug",
    "build": "npm run build:release",
    "check": "npm run typecheck && npm run lint && npm test"
  },
  "dependencies": {
    "@amazon-devices/react-native-async-storage__async-storage": "~2.1.0",
    "@amazon-devices/react-native-kepler": "^4.0.0",
    "@amazon-devices/react-native-w3cmedia": "~2.3.2",
    "base-64": "^1.0.0",
    "fastestsmallesttextencoderdecoder": "~1.0.22",
    "qrcode-generator": "^1.4.4",
    "react": "19.2.0",
    "react-native": "0.83.0",
    "xmldom": "^0.6.0"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@amazon-devices/eslint-plugin-kepler": "^0.1.4",
    "@amazon-devices/kepler-cli-platform": "^0",
    "@react-native-community/cli": "20.0.0",
    "@react-native/babel-preset": "0.83.0",
    "@react-native/eslint-config": "0.83.0",
    "@react-native/metro-config": "0.83.0",
    "@testing-library/react-native": "^13.0.0",
    "@types/jest": "^29.5.14",
    "@types/react": "^19.2.0",
    "@types/react-test-renderer": "^19.1.0",
    "@typescript-eslint/eslint-plugin": "^6.5.0",
    "babel-jest": "^29.7.0",
    "eslint": "^8.57.1",
    "eslint-plugin-jest": "^27.6.0",
    "jest": "^29.7.0",
    "jsonc-eslint-parser": "^2.4.0",
    "npm-run-all": "^4.1.5",
    "prettier": "^2.8.8",
    "react-test-renderer": "19.2.0",
    "ts-jest": "^29.2.5",
    "typescript": "5.8.3"
  },
  "kepler": {
    "projectType": "application",
    "appName": "kick-vegaOS",
    "targets": [
      "tv"
    ]
  },
  "overrides": {
    "react": "19.2.0",
    "react-native": "0.83.0"
  }
}
